{
  "name": "@lighten/ltn-element",
  "description": "Webcomponent ltn-element following open-wc recommendations",
  "license": "AGPL-3.0-or-later",
  "author": "Data People Connected LTD",
  "version": "0.0.8",
  "main": "dist/src/index.js",
  "module": "dist/src/index.js",
  "exports": {
    ".": "./dist/src/index.js",
    "./ltn-trader.js": "./dist/src/components/ltn-trader.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "analyze": "cem analyze --litelement",
    "build": "rm -rf dist && tsc && npm run analyze -- --exclude dist",
    "licence-check": "./.husky/licence-check",
    "watch": "tsc --watch --preserveWatchOutput",
    "lint": "eslint --ext .ts,.html . && prettier \"**/*.ts\" --check --ignore-path .gitignore",
    "format": "eslint --ext .ts,.html . --fix && prettier \"**/*.ts\" --write --ignore-path .gitignore",
    "test": "npm run build && wtr --coverage",
    "test:watch": "tsc && concurrently -k -r \"tsc --watch --preserveWatchOutput\" \"wtr --watch\"",
    "check": "npm run lint && npm run format && npm run licence-check",
    "prepublishOnly": "tsc && npm run analyze -- --exclude dist",
    "prepare": "husky && [ -f ./.husky/nvm-fix ] && ./.husky/nvm-fix || true"
  },
  "dependencies": {
    "lit": "^3.3.2",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@open-wc/eslint-config": "^13.0.0",
    "@open-wc/testing": "^4.0.0",
    "@types/mocha": "^10.0.10",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "@web/test-runner": "^0.20.2",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "tslib": "^2.8.1",
    "typescript": "^5.6.3"
  },
  "customElements": "custom-elements.json",
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
